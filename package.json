{
  "name": "godoy-3d-modding",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "author": "Gabriel Godoy",
  "description": "Studio integrado de roupas, malhas e pinturas FiveM Legacy",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js modules/clothing/tests/native-formats.test.js modules/clothing/tests/editor-core.test.js modules/vehicles/tests/native-formats.test.js modules/vehicles/tests/uv.test.js modules/vehicles/tests/camera-pan.test.js",
    "test:browser": "node tests/app.e2e.mjs",
    "package:windows": "npm run build:native && npm run build && node --use-env-proxy scripts/portable.mjs",
    "release:check": "node scripts/publish-release.mjs --check",
    "release:publish": "node scripts/publish-release.mjs",
    "test:desktop": "node tests/desktop.e2e.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "fflate": "0.8.3",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "vite": "6.1.0",
    "@electron/packager": "20.0.1",
    "playwright": "1.58.2"
  }
}
